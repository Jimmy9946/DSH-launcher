<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DSHLauncher</AssemblyName>
    <RootNamespace>DSHLauncher</RootNamespace>
    <Version>1.4.0</Version>
    <Company>Jimmy</Company>
    <Copyright>Copyright (c) 2026 Jimmy</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 嵌入鸿蒙 Sans SC 字体：任何电脑打开 exe 都用该字体，无需安装 -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!-- 复用 WinForms 版的共享核心模块（零改动） -->
  <ItemGroup>
    <Compile Include="../csharp/Settings.cs" Link="Shared/Settings.cs" />
    <Compile Include="../csharp/Log.cs" Link="Shared/Log.cs" />
    <Compile Include="../csharp/Core/*.cs" Link="Shared/Core/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
