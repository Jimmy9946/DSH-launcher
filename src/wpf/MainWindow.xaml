<Window x:Class="DSHLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSHLauncher.ViewModels"
        Title="DSH启动器"
        Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="{StaticResource FontMain}"
        UseLayoutRounding="True">

    <!-- 无边框窗口标准配置：消除顶部/边缘缝隙，标题栏完整覆盖 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StepItem}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="14" Height="14" Margin="1"
                         Stroke="#B0C9DE" StrokeThickness="2" Fill="#FFFFFF"
                         VerticalAlignment="Center"/>
                <Path x:Name="Check" Width="14" Height="14" Stretch="Uniform" Visibility="Collapsed"
                      Data="M 1,7 L 5,11 L 13,2" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                <TextBlock x:Name="Txt" Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0"
                           Foreground="{StaticResource TextDimBrush}" FontSize="13.5" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentGlowBrush}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource OkGreenBrush}"/>
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource OkGreenBrush}"/>
                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource FailRedBrush}"/>
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource FailRedBrush}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource FailRedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D9EDFA" Offset="0"/>
                <GradientStop Color="#E9F6FE" Offset="0.55"/>
                <GradientStop Color="#D9EDFA" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 顶部氛围光（PCL 浅蓝光晕） -->
        <Ellipse Width="520" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-140,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#BBDEFB" Offset="0"/>
                    <GradientStop Color="#E1F0FD" Offset="0.5"/>
                    <GradientStop Color="#00D9EDFA" Offset="1"/>
                    <RadialGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="0.6"/>
                        </TransformGroup>
                    </RadialGradientBrush.RelativeTransform>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Opacity>0.6</Ellipse.Opacity>
        </Ellipse>

        <!-- ===== 自定义标题栏（PCL 蓝渐变） ===== -->
        <Border Height="42" VerticalAlignment="Top" MouseLeftButtonDown="TitleBar_MouseDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E88E5" Offset="0"/>
                    <GradientStop Color="#4DA8F0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="White" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#90CAF9" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <TextBlock Text="◆" FontSize="12" FontWeight="Bold" Foreground="#1E88E5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DSH启动器" Foreground="White" FontSize="13.5"
                               FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Click="Minimize_Click" Style="{StaticResource TitleBtn}"/>
                    <Button Content="✕" Click="Close_Click" Style="{StaticResource TitleBtn}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Margin="28,54,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="1.4.0 正式版" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="GitHub作者：Jimmy9946" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="16" Padding="14,5" VerticalAlignment="Center"
                        Background="#FFFFFF" BorderBrush="#C5DEF5" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#90CAF9" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12.5"
                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 进度条装饰 -->
            <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgress}" Value="{Binding Progress}"
                         VerticalAlignment="Top" Margin="0,18,0,0" Maximum="100"/>

            <!-- 中部：左步骤 + 右日志 -->
            <Grid Grid.Row="1" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左卡片：步骤 -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="准备进度" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Steps}" Margin="0,18,0,0"/>
                        <TextBlock Grid.Row="1" Text="{Binding ProgressText}" FontSize="12"
                                   Foreground="{StaticResource AccentGlowBrush}" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- 右卡片：日志 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="运行日志" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        <ScrollViewer x:Name="LogScroller" Grid.Row="1" Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList" ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   FontFamily="Cascadia Mono, Consolas, pack://application:,,,/Fonts/#HarmonyOS Sans SC"
                                                   FontSize="11.5" Foreground="#4A5A6A" TextWrapping="Wrap"
                                                   Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部：设置 + 按钮 -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="端口" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="8,0,0,0"
                             Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"/>
                    <Button Content="自动检测" Click="AutoPickPort_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                    <CheckBox Content="国内镜像" IsChecked="{Binding IsMirror}" Margin="52,0,0,0"
                              Foreground="{StaticResource TextDimBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="打开数据目录" Click="OpenData_Click" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                    <Button Content="仅启动服务" Click="StartOnly_Click" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                    <Button Content="{Binding MainButtonText}" Click="Deploy_Click" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanAct}" FontSize="16" Padding="26,11" MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
